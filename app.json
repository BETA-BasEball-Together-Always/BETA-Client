{
  "expo": {
    "name": "Beta",
    "slug": "Beta",
    "scheme": ["navergjba1aajew6uviirtfpw"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["src/shared/assets/fonts/*"],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#443D4D"
    },
    "ios": {
      "googleServicesFile": "./fcm-ios-com-beta-baseballapp.plist",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "게시글 작성 시 사진을 직접 촬영하여 첨부하거나, 야구네컷 카메라로 프레임 사진을 촬영할 때 사용됩니다.",
        "NSPhotoLibraryUsageDescription": "게시글에 이미지를 첨부하거나, 야구네컷 편집 시 보관함의 사진으로 프레임 이미지를 교체할 때 사용됩니다.",
        "NSPhotoLibraryAddUsageDescription": "편집한 야구네컷 이미지를 사진 보관함에 저장합니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "naversearchapp"
        ],
        "UIDeviceFamily": [1]
      },
      "bundleIdentifier": "com.beta.baseballapp"
    },
    "android": {
      "googleServicesFile": "./fcm-android-com-beta-baseballapp.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.beta.baseballapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-firebase/app",
      "react-native-vision-camera",
      "expo-font",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "d93bc885f3456f69f29a1a4073778dfb",
          "kotlinVersion": "2.1.20"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging"]
          },
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "cb0869cf-b218-49c9-a57c-e29944ee41fb"
      }
    },
    "owner": "beta_app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cb0869cf-b218-49c9-a57c-e29944ee41fb"
    }
  }
}
