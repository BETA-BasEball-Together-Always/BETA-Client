{
  "expo": {
    "name": "Beta",
    "slug": "Beta",
    "scheme": ["navergjba1aajew6uviirtfpw"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "assetBundlePatterns": ["src/shared/assets/fonts/*"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "야구네컷 촬영을 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "사진을 업로드하기 위해 사진 보관함 접근이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "편집된 야구네컷을 사진 보관함에 저장합니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "naversearchapp",
          "kakaokompassauth",
          "kakaolink",
          "naversearchapp"
        ]
      },
      "bundleIdentifier": "com.beta.baseballapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA", "android.permission.CAMERA"],
      "package": "com.beta.baseballapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "react-native-vision-camera",
      "expo-font",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "d93bc885f3456f69f29a1a4073778dfb",
          "kotlinVersion": "2.1.20"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "cb0869cf-b218-49c9-a57c-e29944ee41fb"
      }
    },
    "owner": "beta_app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cb0869cf-b218-49c9-a57c-e29944ee41fb"
    }
  }
}
